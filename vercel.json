{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"cleanUrls": true,
	"trailingSlash": false,
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "X-Frame-Options",
					"value": "SAMEORIGIN"
				}
			]
		},
		{
			"source": "/(engine|templates|media)/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400, stale-while-revalidate=604800"
				}
			]
		},
		{
			"source": "/engine/(.*).(js|html|json)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=0, must-revalidate"
				}
			]
		},
		{
			"source": "/app/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/app/(sw.js|index.html)?",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=0, must-revalidate"
				}
			]
		},
		{
			"source": "/app/sw.js",
			"headers": [
				{
					"key": "Service-Worker-Allowed",
					"value": "/app"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "getkinetic.vercel.app"
				}
			],
			"destination": "https://kinetic.launchloop.tech/:path*",
			"permanent": true
		}
	],
	"rewrites": [
		{
			"source": "/api/auth/google",
			"destination": "/api/account?r=auth/google"
		},
		{
			"source": "/api/auth/dev",
			"destination": "/api/account?r=auth/dev"
		},
		{
			"source": "/api/auth/logout",
			"destination": "/api/account?r=auth/logout"
		},
		{
			"source": "/api/me",
			"destination": "/api/account?r=me"
		},
		{
			"source": "/api/license",
			"destination": "/api/account?r=license"
		},
		{
			"source": "/api/export",
			"destination": "/api/account?r=export"
		},
		{
			"source": "/api/log",
			"destination": "/api/account?r=log"
		},
		{
			"source": "/api/v1/chat/completions",
			"destination": "/api/write"
		},
		{
			"source": "/buy",
			"destination": "/api/buy"
		}
	],
	"functions": {
		"api/write.js": {
			"memory": 1024
		},
		"api/brand.js": {
			"maxDuration": 20
		},
		"api/account.js": {
			"maxDuration": 10
		}
	}
}
