{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"cleanUrls": true,
	"trailingSlash": false,
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "X-Frame-Options",
					"value": "SAMEORIGIN"
				}
			]
		},
		{
			"source": "/(engine|templates|media)/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400, stale-while-revalidate=604800"
				}
			]
		},
		{
			"source": "/engine/(.*).(js|html|json)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=0, must-revalidate"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "getkinetic.vercel.app"
				}
			],
			"destination": "https://kinetic.launchloop.tech/:path*",
			"permanent": true
		}
	],
	"rewrites": [
		{
			"source": "/api/v1/chat/completions",
			"destination": "/api/write"
		},
		{
			"source": "/buy",
			"destination": "/api/buy"
		}
	],
	"functions": {
		"api/write.js": {
			"memory": 1024
		}
	}
}